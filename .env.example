# Shared passcode gating the whole app (no user accounts yet).
APP_PASSCODE=change-me

# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-too

# Set to false only for plain-http local dev (the browser won't send a
# `secure` cookie back over http).
SESSION_COOKIE_SECURE=true

# From https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=short_timer

# Comma-separated list is not supported directly by pydantic-settings' list
# parsing from env vars here; set as a JSON array instead, e.g.:
# CORS_ORIGINS=["http://localhost:5173"]
