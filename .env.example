# Sessions live in the database now, so there's no signing secret to set.
# Two clocks bound one: the idle deadline slides forward as the session is
# used, the absolute one never moves. Both are long on purpose — this is a
# timer opened at a gym, and sessions can be revoked outright now.
SESSION_IDLE_SECONDS=2592000
SESSION_ABSOLUTE_SECONDS=15552000

# Set to false only for plain-http local dev (the browser won't send a
# `secure` cookie back over http).
SESSION_COOKIE_SECURE=true

# Encrypts per-user third-party credentials (e.g. a Wodify API key) before
# they're written to Mongo. Comma-separated, newest key first: new values are
# encrypted with the first, older ones still decrypt with the rest, so a key
# is rotated by prepending a new one and dropping the old once every stored
# value has been rewritten. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to run without credential storage — the app still works, it just
# can't save third-party credentials. Losing these keys means stored
# credentials become unreadable and have to be re-entered.
SECRETS_KEYS=

# From https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cap on a single parse; the SDK's own default is 10 minutes.
ANTHROPIC_TIMEOUT_SECONDS=45
ANTHROPIC_MAX_RETRIES=1

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=shortimer

# --- Accounts ---
# Where the *frontend* lives. Every emailed link (verify, reset, invite) is
# built against this, so it must be the site a browser opens — not this API.
PUBLIC_BASE_URL=http://localhost:5173
PASSWORD_MIN_LENGTH=12
INVITE_TTL_HOURS=336
VERIFY_TTL_HOURS=48
# Short on purpose: a reset link takes over an account outright.
RESET_TTL_MINUTES=60

# --- Passkeys ---
# THIS VALUE IS PERMANENT. It is hashed into every credential at creation and
# cannot be changed: a passkey registered at the apex works from any subdomain,
# while one registered at api.shortimer.com could never be used at the apex.
# So it must be the apex — changing it invalidates every passkey ever issued.
# In production: shortimer.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=shortimer
# Origins the ceremony may come from — the *site*, not this API. They differ on
# purpose: the browser is on shortimer.com while the server runs on
# api.shortimer.com, which is legal because the RP ID may be a registrable
# suffix of the origin. In production: https://shortimer.com
WEBAUTHN_ORIGINS=http://localhost:5173

# --- Outbound email (Postmark) ---
# Off by default, which is what makes signup testable with no provider: the
# link is written to the log instead of being sent. Turn it on in production.
EMAIL_ENABLED=false
POSTMARK_SERVER_TOKEN=
# Must be on the authenticated sending subdomain. shortimer.com publishes
# DMARC with strict alignment (adkim=s), so a From: on the apex fails
# authentication outright rather than merely landing in spam.
EMAIL_FROM=shortimer <no-reply@send.shortimer.com>
POSTMARK_MESSAGE_STREAM=outbound

# --- Metrics (see docs/metrics.md) ---
# Off switches the recording, not just the reading — a deployment that doesn't
# want an events collection shouldn't grow one.
METRICS_ENABLED=true
# How long raw events are kept, enforced by a TTL index.
EVENTS_RETENTION_DAYS=400
# Break-glass access to /api/metrics/operator. The mechanism is the `role`
# field on the user record; this is the fallback for when the database is too
# sick to read a role from. Empty means nobody, which is the right default.
METRICS_ADMIN_USER_IDS=

# How long a request waits for a reachable database before failing. PyMongo
# defaults to 30 seconds, which makes a brief outage look like a hang: every
# request holds a worker for half a minute before returning its 503. Raise it
# only if your database genuinely takes longer than this to elect a primary.
MONGODB_TIMEOUT_MS=5000

# How the MCP server (`hatch run mcp`) authenticates. It has no session to
# derive an owner from, so it presents a per-user API token instead — mint one
# under Settings → API tokens. The owner and the allowed operations both come
# from the token; unset, the MCP tools refuse.
MCP_API_TOKEN=

# Origins allowed to call the API. Comma-separated or a JSON array; in
# production this is the site on GitHub Pages, e.g. https://shortimer.com
CORS_ORIGINS=http://localhost:5173

# --- Trusting the caller's address ------------------------------------------
# Rate limits are counted per client address, so a spoofable address means a
# bypassable limit. Both default to trusting nothing and using the socket peer.
#
# A single-value header set by the platform's proxy, which the caller cannot
# forge — e.g. fly-client-ip, cf-connecting-ip. Leave blank if there isn't one.
CLIENT_IP_HEADER=
# Number of trusted proxies that append to X-Forwarded-For. Azure Container
# Apps' ingress is one such hop, so set this to 1 there. Leave at 0 when the
# app is reachable directly, otherwise callers can forge their own address.
TRUSTED_PROXY_HOPS=0

# --- Abuse and cost controls -------------------------------------------------
RATE_LIMIT_ENABLED=true
# Brute-force protection for the shared passcode. Only failures are counted,
# so a gym behind one WiFi IP can't lock itself out by logging in.
LOGIN_ATTEMPTS_PER_15_MIN=10
# Parsing costs an Anthropic call. The per-subject cap bounds one caller; the
# global cap is the backstop on total spend.
LLM_CALLS_PER_HOUR_PER_SUBJECT=60
LLM_CALLS_PER_HOUR_GLOBAL=500
WRITES_PER_MINUTE_PER_SUBJECT=120
# Longest workout text accepted, guarding token spend on huge pastes.
MAX_WORKOUT_TEXT_CHARS=20000
