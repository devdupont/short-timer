# Shared passcode gating the whole app (no user accounts yet).
APP_PASSCODE=change-me

# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-too
SESSION_MAX_AGE_SECONDS=2592000

# Set to false only for plain-http local dev (the browser won't send a
# `secure` cookie back over http).
SESSION_COOKIE_SECURE=true

# Encrypts per-user third-party credentials (e.g. a Wodify API key) before
# they're written to Mongo. Comma-separated, newest key first: new values are
# encrypted with the first, older ones still decrypt with the rest, so a key
# is rotated by prepending a new one and dropping the old once every stored
# value has been rewritten. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to run without credential storage — the app still works, it just
# can't save third-party credentials. Losing these keys means stored
# credentials become unreadable and have to be re-entered.
SECRETS_KEYS=

# From https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cap on a single parse; the SDK's own default is 10 minutes.
ANTHROPIC_TIMEOUT_SECONDS=45
ANTHROPIC_MAX_RETRIES=1

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=short_timer

# --- Metrics (see docs/metrics.md) ---
# Off switches the recording, not just the reading — a deployment that doesn't
# want an events collection shouldn't grow one.
METRICS_ENABLED=true
# How long raw events are kept, enforced by a TTL index.
EVENTS_RETENTION_DAYS=400
# Who may read /api/metrics/operator — global spend and other users' activity.
# Empty means nobody, which is the right default: there are no roles yet, so
# without this a shared passcode would hand every visitor the Anthropic bill.
METRICS_ADMIN_USER_IDS=

# How long a request waits for a reachable database before failing. PyMongo
# defaults to 30 seconds, which makes a brief outage look like a hang: every
# request holds a worker for half a minute before returning its 503. Raise it
# only if your database genuinely takes longer than this to elect a primary.
MONGODB_TIMEOUT_MS=5000

# Whose library the MCP server (`hatch run mcp`) reads and writes. It has no
# session to derive an owner from, so the deployment names one. Blank means the
# default user, which is everyone while login is a single shared passcode.
MCP_OWNER_ID=

# Origins allowed to call the API. Comma-separated or a JSON array; in
# production this is the site on GitHub Pages, e.g. https://shortimer.com
CORS_ORIGINS=http://localhost:5173

# --- Trusting the caller's address ------------------------------------------
# Rate limits are counted per client address, so a spoofable address means a
# bypassable limit. Both default to trusting nothing and using the socket peer.
#
# A single-value header set by the platform's proxy, which the caller cannot
# forge — e.g. fly-client-ip, cf-connecting-ip. Leave blank if there isn't one.
CLIENT_IP_HEADER=
# Number of trusted proxies that append to X-Forwarded-For. Azure Container
# Apps' ingress is one such hop, so set this to 1 there. Leave at 0 when the
# app is reachable directly, otherwise callers can forge their own address.
TRUSTED_PROXY_HOPS=0

# --- Abuse and cost controls -------------------------------------------------
RATE_LIMIT_ENABLED=true
# Brute-force protection for the shared passcode. Only failures are counted,
# so a gym behind one WiFi IP can't lock itself out by logging in.
LOGIN_ATTEMPTS_PER_15_MIN=10
# Parsing costs an Anthropic call. The per-subject cap bounds one caller; the
# global cap is the backstop on total spend.
LLM_CALLS_PER_HOUR_PER_SUBJECT=60
LLM_CALLS_PER_HOUR_GLOBAL=500
WRITES_PER_MINUTE_PER_SUBJECT=120
# Longest workout text accepted, guarding token spend on huge pastes.
MAX_WORKOUT_TEXT_CHARS=20000
